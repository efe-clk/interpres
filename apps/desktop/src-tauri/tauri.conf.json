{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interpres",
  "version": "0.1.0",
  "identifier": "io.github.efeclk.interpres",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Interpres",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "quick",
        "title": "Interpres Quick",
        "url": "index.html#quick",
        "width": 560,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
